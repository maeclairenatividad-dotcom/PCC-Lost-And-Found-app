# ---- Server ----
PORT=3000
# Use a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-this-to-a-long-random-string
# Set to "production" when deployed. Defaults secure cookies to on then, so the
# site must be served over HTTPS. Set COOKIE_SECURE=false only for plain-http LAN demos.
NODE_ENV=development
# COOKIE_SECURE=true

# ---- Database ----
# Two engines are supported. Pick one:
#
# 1) Neon / Postgres (recommended for deployment). Paste the connection string
#    from the Neon dashboard. `sslmode=require` is required by Neon.
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
#    Timestamps are stored in this wall-clock zone so dates match the school's
#    local time even though Neon runs in UTC.
# PG_TIMEZONE=Asia/Manila
#
# 2) SQLite (default). No server, no setup — the whole database is one file
#    (db/app.db), created automatically on first run.
# DB_PATH=db/app.db

# ---- Email (free options) ----
# Leave MAIL_ENABLED=false while developing. Every email is still written to the
# email_log table and printed to the console, so you can demo it without SMTP.
MAIL_ENABLED=false

# Gmail: turn on 2-Step Verification, then create an App Password (16 chars).
# Brevo/Mailjet/SendGrid free tiers also work over SMTP with their host/credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=youraccount@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="Campus Lost & Found <youraccount@gmail.com>"

# Public URL of your deployed app (used in email links). No trailing slash.
# BASE_URL=https://your-domain.example

# Where claim alerts go. Usually the property office inbox.
ADMIN_ALERT_EMAIL=lostandfound@yourschool.edu.ph

# ---- Policy ----
# Days an item stays in custody before it is flagged for disposal.
CLAIM_WINDOW_DAYS=90
