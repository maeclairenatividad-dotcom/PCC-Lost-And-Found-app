<%- include('../partials/head') %>
<div class="auth-wrap">
  <section class="auth-art">
    <span class="tag">Student Affairs · Property office</span>
    <h1>Every found item gets a tag.</h1>
    <p>Turn in what you find, search what you lost, and claim it with proof.
       Nothing leaves the office until ownership is verified.</p>
    <div class="auth-tags">
      <span class="tag">LF-2026-0118</span>
      <span class="tag">LF-2026-0119</span>
      <span class="tag">LF-2026-0120</span>
    </div>
  </section>

  <section class="auth-form">
    <div class="scene" aria-hidden="true">
      <div class="sign"><span>LOST &amp; FOUND</span></div>
      <div class="tape t1"></div>
      <div class="tape t2"></div>
      <div class="tape v left"></div>
      <div class="tape v right"></div>
    </div>
    <div class="auth-card">
      <div class="auth-brand ghost">
        <img class="auth-logo" src="/img/logo-mark.png" alt="" width="30" height="30">
        <span class="mark">Lost &amp; Found</span>
        <span class="sub">Choose a portal</span>
      </div>
      <div class="card-body">
        <h2>Sign in</h2>
        <p class="muted small lead">Pick who you are and we'll take you to the right dashboard.</p>

        <% success.forEach(function (m) { %><div class="flash ok"><%= m %></div><% }); %>
        <% error.forEach(function (m) { %><div class="flash err"><%= m %></div><% }); %>

        <a class="btn" href="/student/login">Student sign in</a>
        <p class="note">Turn in found items, report what you lost, and track your claims.</p>

        <a class="btn ghost" href="/admin/login">Administrator sign in</a>
        <p class="note mb0">Property office staff — receive items and review claims.</p>

        <div class="card-foot">
          No student account yet? <a href="/register">Create one</a>
        </div>
      </div>
    </div>
  </section>
</div>
</body>
</html>