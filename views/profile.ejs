<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="page-head">
  <div>
    <h1>Your profile</h1>
    <p>
      <% if (currentUser.avatar) { %><img class="avatar avatar-lg" src="<%= currentUser.avatar %>" alt=""
           onerror="this.onerror=null;this.src='/img/avatar-placeholder.svg'"><% } %>
      <%= user.role === 'student'
            ? [user.program, user.section].filter(Boolean).join(' · ') || 'Student'
            : 'Administrator' %>
      · Notifications go to <%= user.email %>.
      <% if (user.role === 'student') { %>Moved to a new section or changed your number? Update it below.<% } %>
    </p>
  </div>
</div>

<div class="split">
  <div class="panel">
    <h2>Details</h2>
    <form method="POST" action="/profile" enctype="multipart/form-data">
      <div class="field">
        <label for="fullName">Full name</label>
        <input type="text" id="fullName" name="fullName" required value="<%= user.full_name %>">
      </div>
      <% if (user.role === 'student') { %>
      <div class="row">
        <div class="field">
          <label for="program">Program</label>
          <select id="program" name="program" required>
            <option value="" disabled <%= !user.program ? 'selected' : '' %>>Select a program…</option>
            <% PROGRAMS.forEach(function (p) { %>
              <option value="<%= p %>" <%= user.program === p ? 'selected' : '' %>><%= p %></option>
            <% }); %>
          </select>
        </div>
<div class="field">
        <label for="section">Section</label>
        <input type="text" id="section" name="section" required
               placeholder="e.g. 1-A" value="<%= user.section || '' %>">
        <p class="hint">Type your section, like 1-A or 3-B.</p>
      </div>
      </div>
      <div class="field avatar-field">
        <label class="avatar-legend" for="photoSelfie">Profile photo <span class="muted">(optional)</span></label>
        <label class="avatar-picker" data-selfie>
          <img id="photoPreview" class="avatar-preview" src="<%= user.avatar_path || '' %>"
               alt="Your photo" <%= user.avatar_path ? '' : 'hidden' %>
               onerror="this.onerror=null;this.hidden=true;var e=document.getElementById('avatarEmpty');if(e){e.style.display='flex';}">
          <span class="avatar-empty" id="avatarEmpty">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span>Your photo</span>
          </span>
        </label>
        <div class="avatar-actions">
          <label class="btn ghost small" data-selfie>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            Take a selfie
          </label>
          <label class="btn ghost small" for="photoPick">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            Choose photo
          </label>
        </div>
        <input type="file" id="photoSelfie" name="avatar" accept="image/*" capture="user" hidden>
        <input type="file" id="photoPick" name="avatar" accept="image/*" hidden>
        <p class="hint">Take a fresh selfie with your camera, or pick a photo from your files.</p>
      </div>
      <% } %>
      <div class="field">
        <label for="phone">Mobile</label>
        <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>">
      </div>
      <button class="btn" type="submit">Save changes</button>
    </form>

    <% if (user.role === 'student') { %>
<script>
        (function () {
          var selfie = document.getElementById('photoSelfie');
        var pick = document.getElementById('photoPick');
        var preview = document.getElementById('photoPreview');
        var empty = document.getElementById('avatarEmpty');
        if (preview.src && !preview.hidden) empty.style.display = 'none';
        function usePhoto(input) {
          if (input.files && input.files[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.hidden = false;
            empty.style.display = 'none';
            (input === selfie ? pick : selfie).value = '';
          }
        }
        selfie.addEventListener('change', function () { usePhoto(selfie); });
        pick.addEventListener('change', function () { usePhoto(pick); });
      })();
    </script>
    <% } %>
  </div>

  <div class="panel">
    <h2>Change password</h2>
    <form method="POST" action="/profile/password">
      <div class="field">
        <label for="currentPassword">Current password</label>
        <input type="password" id="currentPassword" name="currentPassword" required>
      </div>
      <div class="field">
        <label for="newPassword">New password</label>
        <input type="password" id="newPassword" name="newPassword" required minlength="8">
      </div>
      <div class="field">
        <label for="confirmPassword">Repeat new password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required>
      </div>
      <button class="btn" type="submit">Change password</button>
    </form>
  </div>
</div>

<% if (user.role === 'student' && badges) { %>
  <div class="panel" style="margin-top:1.4rem">
    <div class="panel-head">
      <h2>Merit badges</h2>
      <span class="small muted"><span class="tag"><%= badges.earned %></span> of <%= badges.total %> earned</span>
    </div>
    <%- include('partials/achievements') %>
  </div>
<% } %>

<%- include('partials/camera-modal') %>
<script src="/js/camera-capture.js"></script>
<script>cameraCaptureInit('photoSelfie');</script>

<%- include('partials/foot') %>
